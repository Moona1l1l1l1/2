@model List<CourseViewModel>
@{
    ViewData["Title"] = "Курсы";
}

<h1 class="h3 mb-3">Курсы</h1>

@if (ViewBag.Error is string error)
{
    <div class="alert alert-danger">@error</div>
}
else if (Model.Count == 0)
{
    <div class="alert alert-info">Курсов пока нет.</div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr><th>#</th><th>Название</th><th>Кредиты</th><th>Преподаватель</th><th>Студентов</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Id</td>
                <td>@c.Name</td>
                <td>@c.Credits</td>
                <td>@(c.Teacher?.FullName ?? "—")</td>
                <td>@c.EnrolledStudentsCount</td>
                <td><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@c.Id">Подробнее</a></td>
            </tr>
        }
        </tbody>
    </table>
}
